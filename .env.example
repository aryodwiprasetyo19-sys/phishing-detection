# ============================================================
# Contoh konfigurasi lingkungan PhishGuard XAI
# Salin berkas ini menjadi ".env" lalu sesuaikan nilainya:
#     cp .env.example .env
# ============================================================

# --- Koneksi database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phishing_detector_db

# --- Keamanan aplikasi Flask ---
# Ganti dengan string acak yang panjang di lingkungan produksi.
# Contoh membuat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-secret-key-acak-di-produksi
